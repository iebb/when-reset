// Harris-owned signing defaults for this fork of iebb/when-reset.
// Override any value from the command line:
//   xcodebuild APP_BUNDLE_IDENTIFIER=com.example.whenreset DEVELOPMENT_TEAM=ABCDE12345
// or in a gitignored Config/Local.xcconfig.
#include? "Local.xcconfig"

APP_BUNDLE_IDENTIFIER = com.harrisliangsu.whenreset
WIDGET_BUNDLE_IDENTIFIER = com.harrisliangsu.whenreset.widgets
APP_GROUP_IDENTIFIER = group.com.harrisliangsu.whenreset
KEYCHAIN_GROUP_SUFFIX = com.harrisliangsu.whenreset.shared
// Marketing version and build number are set only in project.yml.
// After changing them, run `xcodegen generate --spec project.yml` and commit
// WhenReset.xcodeproj. CI rejects a project that does not match project.yml.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
