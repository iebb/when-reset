          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个密钥没有 Coding Plan 额度。按量计费和通用 API key 不在 Blinky 的范围内。请使用 Coding Plan 密钥，或改用浏览器登录。"
          }
        }
      }
