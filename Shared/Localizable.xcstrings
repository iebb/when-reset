          }
        }
      }
    },
    "The fresh credential is sent directly to the Worker, is not stored on this Mac, and can never be downloaded from the Worker.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fresh credential is sent directly to the Worker, is not stored on this Mac, and can never be downloaded from the Worker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新的凭据会直接发给 Worker，不保存在这台 Mac 上，Worker 也不会把它下载回来。"
          }
        }
      }
    },
    "The key is stored in iCloud Keychain. Server monitoring uploads it only to a self-hosted Worker after you separately confirm that account setting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is stored in iCloud Keychain. Server monitoring uploads it only to a self-hosted Worker after you separately confirm that account setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥保存在 iCloud 钥匙串。只有你单独确认该账号后，服务器监控才会把它上传到自托管 Worker。"
          }
        }
      }
    },
    "The provider did not return an active reset window.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider did not return an active reset window."
          }
        },
