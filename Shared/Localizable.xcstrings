          "stringUnit": {
            "state": "translated",
            "value": "提供方没有返回仍在生效的重置窗口。"
          }
        }
      }
    },
    "This deletes the account and credentials from devices using your iCloud Keychain, plus this device’s cached usage, recorded history, and monitor settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the account and credentials from devices using your iCloud Keychain, plus this device’s cached usage, recorded history, and monitor settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从使用你 iCloud 钥匙串的设备上删除账号和凭据，并删除这台设备上的缓存用量、记录的历史和监控设置。"
          }
        }
      }
    },
    "This deletes the demo and its generated usage from this device.": {
      "localizations": {
